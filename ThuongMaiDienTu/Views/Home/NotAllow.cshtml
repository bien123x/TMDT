@{
    ViewData["Title"] = "Yêu cầu quyền truy cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Truy cập bị từ chối
                    </h3>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-lock fa-5x text-danger mb-3"></i>
                        <h4>Bạn không có quyền truy cập chức năng này</h4>
                        <p class="lead">Để sử dụng chức năng này, bạn cần đăng nhập với tài khoản có quyền phù hợp.</p>
                    </div>

                    <div class="alert alert-info">
                        <p>
                            <i class="fas fa-info-circle me-2"></i>
                            @if (TempData["AccessMessage"] != null)
                            {
                                @TempData["AccessMessage"]
                            }
                            else
                            {
                                <span>Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là một lỗi.</span>
                            }
                        </p>
                    </div>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i>Trang chủ
                        </a>
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-success ms-2">
                            <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>