@model IEnumerable<ThuongMaiDienTu.ViewModels.NguoiDungViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">
                <i class="fa-solid fa-users me-2"></i>Quản lý người dùng
            </h2>
            <p class="text-muted">Quản lý tất cả người dùng trong hệ thống</p>
        </div>
        <div class="col-md-4 text-md-end d-flex align-items-center justify-content-md-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-user-plus me-1"></i>Thêm người dùng mới
            </a>
        </div>
    </div>

    <!-- Alert Section -->
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div id="storeGridView" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var item in Model)
        {
            <div class="col user-item" data-user-id="@item.Id" data-user-name="@item.Ho_Ten"
                data-store-date="@item.Ngay_Tao.Ticks">
                <div class="card h-100 border-1 hover-shadow" id="store-card-@item.Id">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-0">
                        <h5 class="mb-0 text-truncate">@item.Ho_Ten</h5>
                            <span class="badge bg-primary rounded-pill me-1">ID: @item.Id</span>
                            @if (item.Trang_Thai)
                            {
                                <span class="badge bg-success" id="status-badge-@item.Id">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" id="status-badge-@item.Id">Đã khóa</span>
                            }
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                             <span class="badge @GetVaiTroBadgeClass(item.Vai_Tro_Id)">
                                @item.Ten_Vai_Tro
                            </span>
                            <br />
                            <small class="text-muted">
                                Email: @item.Email
                            </small>
                            <br />
                            <small class="text-muted">
                                SDT: @item.So_Dien_Thoai
                            </small>
                           
                           
                            <br />
                            <small class="text-muted">
                                <i class="far fa-calendar-alt me-1"></i>
                                Ngày tạo: @item.Ngay_Tao.ToString("dd/MM/yyyy")
                            </small>
                           
                            
                        </div>
                        <p class="card-text description-text" id="store-desc-@item.Id">
                            @if (item.Mo_Ta != null && item.Mo_Ta.Length > 100)
                            {
                                <span title="@item.Mo_Ta">@(item.Mo_Ta.Substring(0, 100) + "...")</span>
                            }
                            else
                            {
                                @(item.Mo_Ta ?? "Không có mô tả")
                            }
                        </p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <div class="d-flex justify-content-between">
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Details", "NguoiDung", new { id = item.Id })"
                                    class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                    <i class="fas fa-info-circle"></i> Xem chi tiết
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-warning edit-user-btn"
                                    data-user-id="@item.Id" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i> Sửa thông tin
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm @(item.Trang_Thai ? "btn-outline-danger" : "btn-outline-success") toggle-status-btn"
                                    data-user-id="@item.Id" data-current-status="@(item.Trang_Thai ? "active" : "locked")" 
                                    title="@(item.Trang_Thai ? "Khóa người dùng" : "Mở khóa người dùng")">
                                @if (item.Trang_Thai)
                                {
                                    <i class="fas fa-lock"></i> <span id="toggle-text-@item.Id">Khóa</span>
                                }
                                else
                                {
                                    <i class="fas fa-lock-open"></i> <span id="toggle-text-@item.Id">Mở khóa</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
<div class="card-footer bg-white py-3">
    <div class="row align-items-center">
        <div class="col-md-6">
            <span>Hiển thị <strong>@Model.Count()</strong> trong tổng số
                <strong>@ViewBag.TotalItems</strong> người
                dùng</span>
        </div>
        <div class="col-md-6">
            <nav aria-label="Page navigation">
                @if (ViewBag.TotalPages > 1)
                {
                    <ul class="pagination justify-content-end mb-0">
                        <!-- First page -->
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="DSNguoiDung" asp-route-page="1"
                                asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="fas fa-angle-double-left"></i>
                            </a>
                        </li>

                        <!-- Previous page -->
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="DSNguoiDung" asp-route-page="@(ViewBag.CurrentPage - 1)"
                                asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                            int endPage = Math.Min(ViewBag.TotalPages, startPage + 4);
                            if (endPage - startPage < 4 && startPage > 1)
                            {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="DSNguoiDung" asp-route-page="@i"
                                    asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }

                        <!-- Next page -->
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="DSNguoiDung" asp-route-page="@(ViewBag.CurrentPage + 1)"
                                asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </li>

                        <!-- Last page -->
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="DSNguoiDung" asp-route-page="@ViewBag.TotalPages"
                                asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="fas fa-angle-double-right"></i>
                            </a>
                        </li>
                    </ul>
                }
            </nav>
        </div>
    </div>
</div>


<!-- Modal xác nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận thay đổi trạng thái</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <a href="#" id="confirmActionBtn" class="btn btn-primary">Xác nhận</a>
            </div>
        </div>
    </div>
</div>


<!-- Modal chỉnh sửa ngươi dung -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Chỉnh sửa thông tin người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    <input type="hidden" id="editUserId" name="id" />
                    <div class="mb-3">
                        <label for="editUserName" class="form-label">Họ Tên</label>
                        <input type="text" class="form-control" id="editUserName" name="Ho_Ten" required>
                        <div class="invalid-feedback" id="editUserNameFeedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editUserEmail" class="form-label">Email</label>
                        <input type="text" class="form-control" id="editUserEmail" name="Email" required>
                        <div class="invalid-feedback" id="editUserEmailFeedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editUserSDT" class="form-label">SDT</label>
                        <input type="text" class="form-control" id="editUserSDT" name="So_Dien_Thoai" required>
                        <div class="invalid-feedback" id="editUserSDTFeedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editUserPassword" class="form-label">Mật khẩu <span class="text-muted">(để trống nếu không thay đổi)</span></label>
                        <input type="password" class="form-control" id="editUserPassword" name="Mat_Khau">
                        <div class="invalid-feedback" id="editUserPasswordFeedback"></div>
                        <div class="form-text">Chỉ nhập khi muốn thay đổi mật khẩu</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="editUserDescription" class="form-label">Mô tả</label>
                        <textarea class="form-control" id="editUserDescription" name="Mo_Ta" rows="5"></textarea>
                        <div class="invalid-feedback" id="editUserDescriptionFeedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="saveUserChanges">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận khóa/mở khóa người dùng -->
<div class="modal fade" id="toggleStatusModal" tabindex="-1" aria-labelledby="toggleStatusModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="toggleStatusModalLabel">Xác nhận thay đổi trạng thái</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="toggleStatusMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="confirmToggleStatus">Xác nhận</button>
            </div>
        </div>
    </div>
</div>
<!-- Toast thông báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="storeToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto" id="toastTitle">Thông báo</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage">
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo toast
            const toastElement = document.getElementById('storeToast');
            const toast = new bootstrap.Toast(toastElement);
            const toastTitle = document.getElementById('toastTitle');
            const toastMessage = document.getElementById('toastMessage');

            // Khởi tạo modal
            const editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
            const toggleStatusModal = new bootstrap.Modal(document.getElementById('toggleStatusModal'));

            let currentUserId;
            let currentStatus;

            // Xử lý sự kiện click nút chỉnh sửa
            document.querySelectorAll('.edit-user-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const userId = this.getAttribute('data-user-id');
                    loadUserData(userId);
                });
            });
            // Xử lý sự kiện click nút thay đổi trạng thái
            document.querySelectorAll('.toggle-status-btn').forEach(button => {
                button.addEventListener('click', function () {
                    currentUserId = this.getAttribute('data-user-id');
                    currentStatus = this.getAttribute('data-current-status');

                    const message = currentStatus === 'active'
                        ? 'Bạn có chắc chắn muốn khóa người dùng này? '
                        : 'Bạn có chắc chắn muốn mở khóa người dùng này? ';

                    document.getElementById('toggleStatusMessage').textContent = message;
                    toggleStatusModal.show();
                });

            });
            document.getElementById('confirmToggleStatus').addEventListener('click', function () {
                toggleUserStatus(currentUserId);
            });

            // Nút lưu thay đổi
            document.getElementById('saveUserChanges').addEventListener('click', function () {
                updateUser();
            });
            // Hàm tải dữ liệu cửa hàng
            function loadUserData(userId) {
                console.log("Đang gọi API GetUserData với ID:", userId);
                fetch(`/NguoiDung/GetUserData/${userId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => {
                        console.log("Response status:", response.status);
                        if (!response.ok) {
                            console.log("Response error:", response);
                            throw new Error('Không thể tải dữ liệu người dùng');
                        }
                        return response.json();
                })
                .then(data => {
                    console.log(data);
                    document.getElementById('editUserId').value = data.id;
                    document.getElementById('editUserName').value = data.ho_Ten;
                        document.getElementById('editUserEmail').value = data.email;
                        document.getElementById('editUserSDT').value = data.so_Dien_Thoai;
                    document.getElementById('editUserDescription').value = data.mo_Ta;

                    // Hiển thị modal
                    editModal.show();
                })
                .catch(error => {
                        console.error("Lỗi chi tiết:", error);
                        showToast('Lỗi', error.message, false);
                });
            }
            function toggleUserStatus(userId) {
                // Gửi request đến server
                fetch(`/NguoiDung/ToggleUserStatus/${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Không thể thay đổi trạng thái người dùng');
                    }
                    return response.json();
                })
                .then(result => {
                    if (result.success) {
                        // Cập nhật UI
                        const statusBadge = document.getElementById(`status-badge-${userId}`);
                        const toggleButton = document.querySelector(`.toggle-status-btn[data-user-id="${userId}"]`);
                        const toggleText = document.getElementById(`toggle-text-${userId}`);
                        
                        if (statusBadge) {
                            if (result.newStatus) {
                                // Người dùng được kích hoạt
                                statusBadge.textContent = 'Hoạt động';
                                statusBadge.className = 'badge bg-success';
                                
                                if (toggleButton) {
                                    toggleButton.classList.remove('btn-outline-success');
                                    toggleButton.classList.add('btn-outline-danger');
                                    toggleButton.setAttribute('data-current-status', 'active');
                                    toggleButton.setAttribute('title', 'Khóa người dùng');
                                }
                                
                                if (toggleText) {
                                    toggleText.textContent = 'Khóa';
                                    toggleButton.querySelector('i').className = 'fas fa-lock';
                                }
                            } else {
                                // Người dùng bị khóa
                                statusBadge.textContent = 'Đã khóa';
                                statusBadge.className = 'badge bg-danger';
                                
                                if (toggleButton) {
                                    toggleButton.classList.remove('btn-outline-danger');
                                    toggleButton.classList.add('btn-outline-success');
                                    toggleButton.setAttribute('data-current-status', 'locked');
                                    toggleButton.setAttribute('title', 'Mở khóa người dùng');
                                }
                                
                                if (toggleText) {
                                    toggleText.textContent = 'Mở khóa';
                                    toggleButton.querySelector('i').className = 'fas fa-lock-open';
                                }
                            }
                        }
                        
                        // Hiển thị thông báo thành công
                        showToast('Thành công', result.message, true);
                    } else {
                        // Hiển thị lỗi
                        showToast('Lỗi', result.message || 'Không thể thay đổi trạng thái người dùng', false);
                    }
                })
                .catch(error => {
                    showToast('Lỗi', error.message, false);
                    console.error('Error:', error);
                })
                .finally(() => {
                    // Đóng modal xác nhận
                    toggleStatusModal.hide();
                });
                }
            function updateUser() {
                const userId = document.getElementById('editUserId').value;
                const userName = document.getElementById('editUserName').value;
                const userEmail = document.getElementById('editUserEmail').value;
                const userSDT = document.getElementById('editUserSDT').value;
                const userPassword = document.getElementById('editUserPassword').value;
                const userDescription = document.getElementById('editUserDescription').value;
                document.getElementById('editUserEmail').classList.remove('is-invalid');
                document.getElementById('editUserSDT').classList.remove('is-invalid');
                document.getElementById('editUserName').classList.remove('is-invalid');
                document.getElementById('editUserPassword').classList.remove('is-invalid');
                document.getElementById('editUserDescription').classList.remove('is-invalid');

                // Tạo dữ liệu để gửi
                const userData = {
                    id: userId,
                    Ho_Ten: userName,
                    Email: userEmail,
                    So_Dien_Thoai: userSDT,
                    Mo_Ta: userDescription
                };
                if (userPassword && userPassword.trim().length > 0) {
                    userData.Mat_Khau = userPassword;
                }

                // Gửi request PATCH
                fetch(`/NguoiDung/EditND/${userId}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(userData)
                })
                    .then(response => response.json())
                    .then(result => {
                        console.log('Response from EditND:', result); // Thêm dòng này
                        if (result.success) {
                            // Cập nhật UI
                            updateUserUI(userId, userName, userEmail, userSDT, userDescription);
                            // Đóng modal
                            editModal.hide();

                            // Hiển thị thông báo thành công
                            showToast('Thành công', result.message, true);
                        } else {
                            console.log('Cập nhật thất bại:', result.message, result.errors);
                            // Hiển thị lỗi
                            if (result.errors && result.errors.length > 0) {
                                // Hiển thị lỗi validation
                                result.errors.forEach(error => {
                                    if (error.includes("Ho_Ten")) {
                                        document.getElementById('editUserName').classList.add('is-invalid');
                                        document.getElementById('editUserNameFeedback').textContent = error;
                                    }
                                    if (error.includes("Email")) {
                                        document.getElementById('editUserEmail').classList.add('is-invalid');
                                        document.getElementById('editUserEmailFeedback').textContent = error;
                                    }
                                    if (error.includes("So_Dien_Thoai")) {
                                        document.getElementById('editUserSDT').classList.add('is-invalid');
                                        document.getElementById('editUserSDTFeedback').textContent = error;
                                    }
                                    if (error.includes("Mo_Ta")) {
                                        document.getElementById('editUserDescription').classList.add('is-invalid');
                                        document.getElementById('editUserDescriptionFeedback').textContent = error;
                                    }
                                    
                                });
                            }

                            showToast('Lỗi', result.message, false);
                        }
                    })
                    .catch(error => {
                        showToast('Lỗi', 'Có lỗi xảy ra khi cập nhật người dùng', false);
                        console.error('Error:', error);
                    });
            }
            // Thêm hàm cập nhật UI người dùng
            function updateUserUI(userId, userName, userEmail, userSDT, userDescription) {
                // Cập nhật thông tin hiển thị trên card người dùng
                const card = document.getElementById(`store-card-${userId}`);
                if (card) {
                    // Cập nhật tên người dùng
                    const titleElement = card.querySelector('.card-header h5');
                    if (titleElement) titleElement.textContent = userName;

                    // Cập nhật email và số điện thoại
                    const emailElement = card.querySelector('.card-body small:nth-of-type(1)');
                    if (emailElement) emailElement.textContent = `Email: ${userEmail}`;

                    const sdtElement = card.querySelector('.card-body small:nth-of-type(2)');
                    if (sdtElement) sdtElement.textContent = `SDT: ${userSDT}`;

                    // Cập nhật mô tả
                    const descElement = document.getElementById(`store-desc-${userId}`);
                    if (descElement) {
                        if (userDescription && userDescription.length > 100) {
                            descElement.innerHTML = `<span title="${userDescription}">${userDescription.substring(0, 100)}...</span>`;
                        } else {
                            descElement.textContent = userDescription || "Không có mô tả";
                        }
                    }
                }

                // Cập nhật dữ liệu data attribute của phần tử
                const userItem = document.querySelector(`.user-item[data-user-id="${userId}"]`);
                if (userItem) {
                    userItem.setAttribute('data-user-name', userName);
                }
            }
            function showToast(title, message, success) {
                toastTitle.textContent = title;
                toastMessage.textContent = message;
                toastElement.className = 'toast ' + (success ? 'bg-success' : 'bg-danger');
                toast.show();
            }
        });
    </script>
}
@functions {
    string GetVaiTroBadgeClass(int vaiTroId)
    {
        return vaiTroId switch
        {
            1 => "bg-primary", // người mua
            2 => "bg-success", // người bán
            3 => "bg-danger", // admin
            _ => "bg-secondary"
        };
    }
}